{
  "experiment": "trace_llm",
  "seed": 42,
  "tasks": [
    "C-STANCE",
    "FOMC",
    "MeetingBank",
    "ScienceQA",
    "NumGLUE-cm",
    "NumGLUE-ds",
    "20Minuten"
  ],
  "train": {
    "append_eos": true,
    "backend": "fast",
    "batch_size": 8,
    "device_map": {
      "lm_head": 1,
      "model.embed_tokens": 0,
      "model.layers.0": 0,
      "model.layers.1": 0,
      "model.layers.10": 0,
      "model.layers.11": 0,
      "model.layers.12": 0,
      "model.layers.13": 0,
      "model.layers.14": 0,
      "model.layers.15": 0,
      "model.layers.16": 1,
      "model.layers.17": 1,
      "model.layers.18": 1,
      "model.layers.19": 1,
      "model.layers.2": 0,
      "model.layers.20": 1,
      "model.layers.21": 1,
      "model.layers.22": 1,
      "model.layers.23": 1,
      "model.layers.24": 1,
      "model.layers.25": 1,
      "model.layers.26": 1,
      "model.layers.27": 1,
      "model.layers.28": 1,
      "model.layers.29": 1,
      "model.layers.3": 0,
      "model.layers.30": 1,
      "model.layers.31": 1,
      "model.layers.4": 0,
      "model.layers.5": 0,
      "model.layers.6": 0,
      "model.layers.7": 0,
      "model.layers.8": 0,
      "model.layers.9": 0,
      "model.norm": 1,
      "model.rotary_emb": 0
    },
    "fused": true,
    "gradient_checkpointing": true,
    "learning_rate": 2e-05,
    "log_every": 20,
    "mask": {
      "embedding_probability": 0,
      "probability": 0.5,
      "scope": "block-linear"
    },
    "max_grad_norm": 1.0,
    "max_length": 512,
    "method": "smat",
    "optimizer": "adamw",
    "padding": "dynamic",
    "perturb": {
      "rms": 0.002
    },
    "scale": {
      "alpha_min": 0.2,
      "scope": "global"
    },
    "schedule": "constant",
    "smat": {
      "interval": 4,
      "mode": "joint"
    },
    "weight_decay": 0.001,
    "offload_base": true
  },
  "evaluation": {
    "concurrency": 32,
    "numglue_cm_include_test": false,
    "repeats": 3,
    "save_samples": true,
    "split": "eval"
  },
  "name": "llama8b_adamw_smat",
  "base_model": "${MODEL_ROOT}/Llama-3.1-8B-Instruct",
  "data_root": "${DATA_ROOT}/trace",
  "work_root": "${OUTPUT_ROOT}/training",
  "merging": {
    "scale": 0.2,
    "ties_scale": 0.2,
    "dare_scale": 0.2,
    "della_scale": 0.6,
    "ties_retention": 0.5,
    "dare_drop": 0.3,
    "della_drop": 0.5,
    "della_window": 0.14,
    "seed": 42
  }
}
