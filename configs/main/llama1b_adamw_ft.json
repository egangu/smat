{
  "experiment": "trace_llm",
  "seed": 42,
  "tasks": [
    "C-STANCE",
    "FOMC",
    "MeetingBank",
    "ScienceQA",
    "NumGLUE-cm",
    "NumGLUE-ds",
    "20Minuten"
  ],
  "train": {
    "append_eos": true,
    "batch_size": 8,
    "fused": true,
    "gradient_checkpointing": false,
    "learning_rate": 2e-05,
    "log_every": 20,
    "max_grad_norm": 1.0,
    "max_length": 512,
    "method": "ft",
    "optimizer": "adamw",
    "padding": "dynamic",
    "schedule": "constant",
    "weight_decay": 0.001
  },
  "evaluation": {
    "concurrency": 32,
    "numglue_cm_include_test": false,
    "repeats": 3,
    "save_samples": true,
    "split": "eval"
  },
  "name": "llama1b_adamw_ft",
  "base_model": "${MODEL_ROOT}/Llama-3.2-1B-Instruct",
  "data_root": "${DATA_ROOT}/trace",
  "work_root": "${OUTPUT_ROOT}/training",
  "merging": {
    "scale": 0.3,
    "ties_scale": 0.4,
    "dare_scale": 0.4,
    "della_scale": 0.9,
    "ties_retention": 0.5,
    "dare_drop": 0.3,
    "della_drop": 0.5,
    "della_window": 0.14,
    "seed": 42
  }
}
